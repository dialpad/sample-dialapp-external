{
  "name": "sample-dialapp-external",
  "version": "0.1.0",
  "private": true,
  "description": "Acme CRM: a reference partner rightbar app for Dialpad",
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "types:check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dialpad/dialapp-external-sdk": "link:../dialapp-external",
    "@dialpad/dialtone": "^10.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "^1.6.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.0"
  }
}
